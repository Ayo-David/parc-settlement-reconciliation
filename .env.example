PORT=3011
HOST=0.0.0.0
# ADR-023, D178: the shared database; this service sees only the settlement schema.
DATABASE_URL=postgresql://parc_settlement_app:change-me@localhost:5432/parc_treasury_settlement
# Migrations run as the schema owner (NOBYPASSRLS), never as the app login.
MIGRATION_DATABASE_URL=postgresql://parc_settlement_migrator:change-me@localhost:5432/parc_treasury_settlement
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_JWT_ISSUER=https://auth.parc.invalid
RABBITMQ_URL=amqp://127.0.0.1:5672
# D180: raw statement files, encrypted by this service (AES-256-GCM) before upload to MinIO.
STATEMENT_STORE_ENDPOINT=http://localhost:59000
STATEMENT_STORE_REGION=us-east-1
STATEMENT_STORE_BUCKET=parc-settlement-statements
STATEMENT_STORE_ACCESS_KEY_ID=replace-with-minio-access-key
STATEMENT_STORE_SECRET_ACCESS_KEY=replace-with-minio-secret-key
# 32 random bytes, base64. Rotating it means adding a new key id; old files keep theirs.
STATEMENT_ENCRYPTION_KEY_ID=replace-with-key-id
STATEMENT_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
